{
  "name": "still-here",
  "version": "0.0.0",
  "private": true,
  "description": "STILL HERE, Vandalway Industries' presence-certification platform.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "serve": "node scripts/build.mjs && node scripts/serve-pages.mjs site 5320",
    "check:links": "node scripts/check-links.mjs site",
    "test:unit": "node --test 'tests/unit/**/*.test.ts'",
    "test:e2e": "cd e2e && npx playwright test",
    "continuity": "node scripts/continuity-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "jspdf": "4.2.1",
    "jsqr": "1.4.0",
    "pdfjs-dist": "6.4.299",
    "svg2pdf.js": "2.8.1"
  }
}
